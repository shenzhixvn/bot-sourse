{
  "name": "bot",
  "version": "1.3.0",
  "description": "BOT (Bot Assistant) - Cross-platform AI Desktop Assistant",
  "homepage": "https://bot.x6m.top/",
  "main": "src/main.js",
  "author": "Shen Ruoxuan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.bot.assistant",
    "productName": "BOT",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "core/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BOT",
      "installerLanguages": ["zh_CN"]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icon.png"
    },
    "dmg": {
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "desktop": {
        "Name": "BOT",
        "Comment": "AI Desktop Assistant",
        "Categories": "Utility;"
      }
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://bot.x6m.top/"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}