{
  "name": "bot",
  "version": "1.3.0",
  "description": "BOT（Bot Assistant）— Windows 桌面版 AI 助手",
  "homepage": "https://bot.x6m.top/",
  "main": "src/main.js",
  "author": "沈若萱",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.bot.assistant",
    "productName": "BOT",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "core/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BOT",
      "installerLanguages": [
        "zh_CN"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://bot.x6m.top/"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
